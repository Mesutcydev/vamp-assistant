+// Vamp: keep allocator scratch bounded on 16 GB Macs before any weights or
+// kernel self-tests allocate. The library default can retain a second model's
+// worth of freed buffers and force the machine into swap.
+// The tiled route retains a reordered copy of the quantized weights. On
+// smaller Macs keep the stored layout, which the fork validates bitwise.
+if ProcessInfo.processInfo.physicalMemory <= 24 * 1024 * 1024 * 1024 {
+    setenv("DARKBLOOM_BONSAI_TENSOR_ROUTE_TILED", "0", 1)
